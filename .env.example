# Supabase (existing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat — required for iOS IAP builds
VITE_REVENUECAT_IOS_API_KEY=appl_xxxxxxxx
# Set to true once Supabase has an Apple Services ID and OAuth secret (shows Apple sign-in on web).
VITE_APPLE_SIGNIN_WEB=false
# Optional Android later
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxx
